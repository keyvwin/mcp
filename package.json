  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/b2bsearch/mcp" },
  "homepage": "https://github.com/b2bsearch/mcp",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "apify-client": "2.25.0",
    "zod": "4.6.5"
  },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "24.19.2" }
}
